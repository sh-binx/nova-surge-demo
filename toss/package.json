{
  "name": "nova-surge-toss",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NOVA SURGE 앱인토스(Apps in Toss) 빌드 — ../slice/index.html 을 입력으로 .ait 번들을 만든다",
  "scripts": {
    "prepare:toss": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && sh scripts/dev.sh",
    "build:toss": "node scripts/prepare.mjs && tsc --noEmit && vite build && node scripts/scan.mjs && ait build",
    "scan": "node scripts/scan.mjs",
    "e2e": "playwright test",
    "deploy:toss": "ait deploy"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.5.0",
    "meshoptimizer": "^1.2.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@playwright/test": "1.63.0",
    "pretendard": "1.3.9",
    "subset-font": "2.9.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
